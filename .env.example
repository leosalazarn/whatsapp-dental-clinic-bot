# ============================================================
#  VALERIA — Environment Variables
# ============================================================

# ── Anthropic (Valeria AI) ────────────────────────────────
# Get this here console.anthropic.com → API Keys → Create Key
ANTHROPIC_API_KEY=sk-ant-api03-REPLACE_WITH_YOUR_KEY

# ── Bot Persona (required) ────────────────────────────────
# Customize this to describe your clinic and bot persona. Injected into the system prompt.
BOT_PERSONA="You are Valeria, a friendly AI assistant for [Dental Clinic Name] in [City, Country]. Specialist in aesthetic dentistry. Available 24/7."

# ── WhatsApp Business API (Meta) ─────────────────────────────
# Get this here developers.facebook.com → tu app → WhatsApp → API Setup

# Access Token (Get this here: developers.facebook.com → tu app → WhatsApp → API Setup → Generate Token)
WA_ACCESS_TOKEN=EAAxxxxx_REPLACE_WITH_YOUR_TOKEN

# Phone Number ID (ID phone number of your WhatsApp Business Account)
# Ejemplo: 123456789012345
WA_PHONE_NUMBER_ID=REPLACE_WITH_YOUR_PHONE_NUMBER_ID

# Receptionist WhatsApp number (E.164, no +) — receives lead notifications when a patient reaches PAYMENT phase
RECEPTIONIST_PHONE=5731XXXXXXXXXX

# ── Webhook's security ────────────────────────────────────
# Example: dental_[City]_valeria_2024
# Use the same value, you can get it from here: Meta Developers → Webhooks
VERIFY_TOKEN=REPLACE_WITH_YOUR_TOKEN_SECRETO

# App Secret (Meta → App Settings → Basic → App Secret). Used to verify
# x-hub-signature-256 on inbound webhook POSTs. REQUIRED — server fails to start without it.
META_APP_SECRET=REPLACE_WITH_YOUR_APP_SECRET

# ── Server ─────────────────────────────────────────────────
# Render.com asign PORT automatically — do not change this value
PORT=3000

# ── Banking info ─────────────────────────────
BANK_HOLDER_NAME="TEST NAME"
BANK_HOLDER_CC=123456789
BANCOLOMBIA_ACCOUNT=123
NEQUI_NUMBER=3150000000
DAVIVIENDA_ACCOUNT=444444

# ── Business Prices (COP) ──────────────────────────────
# All prices in Colombian Pesos
CONSULTATION_PRICE=0
BOOK_PRICE=0
MIN_RANGE_PRICE=0
MAX_RANGE_PRICE=0

# ── Supabase (Database) ───────────────────────────────
# Get these from your Supabase project settings → API
SUPABASE_URL=https://your-supabase-url.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── Debug / Analytics (Protected endpoints) ─────────────
DEBUG_API_KEY=REPLACE_WITH_YOUR_API_KEY_FOR_DEBUGGING